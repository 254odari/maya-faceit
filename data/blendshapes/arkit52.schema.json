{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maya-faceit.dev/schemas/arkit52.schema.json",

  "title": "maya_faceit ARKit Blendshape Database",

  "description": "Schema for validating the ARKit52 blendshape database.",

  "type": "object",

  "required": [
    "metadata",
    "plugin",
    "compatibility",
    "statistics",
    "taxonomy",
    "defaults",
    "validation",
    "migration",
    "channels"
  ],

  "additionalProperties": false,

  "properties": {

    "metadata": {
      "type": "object",

      "required": [
        "database",
        "database_version",
        "schema_version",
        "format_version"
      ],

      "properties": {

        "database": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "database_version": {
          "type": "string"
        },

        "schema_version": {
          "type": "string"
        },

        "format_version": {
          "type": "integer"
        },

        "created": {
          "type": "string",
          "format": "date-time"
        },

        "modified": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "plugin": {
      "type": "object",

      "required": [
        "name",
        "version"
      ],

      "properties": {

        "name": {
          "type": "string"
        },

        "display_name": {
          "type": "string"
        },

        "version": {
          "type": "string"
        },

        "build": {
          "type": "string"
        },

        "author": {
          "type": "string"
        },

        "license": {
          "type": "string"
        }
      }
    },

    "compatibility": {
      "type": "object"
    },

    "statistics": {
      "type": "object"
    },

    "taxonomy": {
      "type": "object"
    },

    "defaults": {
      "type": "object"
    },

    "validation": {
      "type": "object"
    },

    "migration": {
      "type": "object"
    },

    "ui_defaults": {
      "type": "object"
    },

    "channels": {

      "type": "array",

      "minItems": 52,

      "maxItems": 52,

      "items": {

        "$ref": "#/$defs/channel"

      }

    }

  },

  "$defs": {

    "channel": {

      "type": "object",

      "required": [

        "id",
        "name",
        "display_name",
        "category",
        "region",
        "side",
        "description",
        "default",
        "minimum",
        "maximum",
        "symmetry"

      ],

      "additionalProperties": false,

      "properties": {

        "id": {

          "type": "integer",

          "minimum": 0

        },

        "name": {

          "type": "string"

        },

        "display_name": {

          "type": "string"

        },

        "category": {

          "type": "string",

          "enum": [

            "Brows",
            "Eyes",
            "Cheeks",
            "Nose",
            "Jaw",
            "Mouth",
            "Tongue"

          ]

        },

        "region": {

          "type": "string",

          "enum": [

            "Upper Face",
            "Mid Face",
            "Lower Face"

          ]

        },

        "side": {

          "type": "string",

          "enum": [

            "Left",
            "Right",
            "Center"

          ]

        },

        "description": {

          "type": "string"

        },

        "default": {

          "type": "number",

          "minimum": 0,

          "maximum": 1

        },

        "minimum": {

          "type": "number",

          "minimum": 0,

          "maximum": 1

        },

        "maximum": {

          "type": "number",

          "minimum": 0,

          "maximum": 1

        },

        "symmetry": {

          "$ref": "#/$defs/symmetry"

        },

        "animation": {

          "$ref": "#/$defs/animation"

        },

        "driver": {

          "$ref": "#/$defs/driver"

        },

        "ui": {

          "$ref": "#/$defs/ui"

        },

        "keywords": {

          "type": "array",

          "items": {

            "type": "string"

          }

        }

      }

    },

    "symmetry": {

      "type": "object",

      "required": [

        "enabled",
        "partner"

      ],

      "properties": {

        "enabled": {

          "type": "boolean"

        },

        "partner": {

          "type": [

            "string",
            "null"

          ]

        }

      }

    },

    "animation": {

      "type": "object",

      "properties": {

        "animatable": {

          "type": "boolean"

        },

        "streamable": {

          "type": "boolean"

        },

        "mirrorable": {

          "type": "boolean"

        },

        "corrective": {

          "type": "boolean"

        }

      }

    },

    "driver": {

      "type": "object",

      "properties": {

        "type": {

          "type": "string"

        },

        "default_weight": {

          "type": "number",

          "minimum": 0,

          "maximum": 1

        }

      }

    },

    "ui": {

      "type": "object",

      "properties": {

        "icon": {

          "type": "string"

        },

        "order": {

          "type": "integer"

        }

      }

    }

  }
}